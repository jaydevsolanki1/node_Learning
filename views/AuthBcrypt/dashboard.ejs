<div class="container-fluid">

    <!-- Header -->

    <div class="row bg-primary text-white shadow-sm py-4 mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold">
                <i class="fa-solid fa-gauge-high"></i>
                Dashboard
            </h2>

            <p class="mb-0">
                Welcome Back,
                <strong>
                    <%= user.name %>
                </strong>
            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a href="/AuthProfile" class="btn btn-light me-2">

                <i class="fa-solid fa-user"></i>

                Profile

            </a>

            <a href="/AuthLogout" class="btn btn-danger">

                <i class="fa-solid fa-right-from-bracket"></i>

                Logout

            </a>

        </div>

    </div>

    <!-- User Information -->

    <div class="row mb-4">

        <div class="col-lg-6">

            <div class="card shadow border-0">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-circle-user"></i>

                        Logged In User

                    </h5>

                </div>

                <div class="card-body">

                    <p>

                        <strong>Name :</strong>

                        <%= user.name %>

                    </p>

                    <p>

                        <strong>Email :</strong>

                        <%= user.email %>

                    </p>

                    <p>

                        <strong>User ID :</strong>

                        <%= user.id %>

                    </p>

                </div>

            </div>

        </div>

    </div>




</div>