<div class="container py-5">
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">Node.js Learning Journey 🚀</h1>
    <p class="lead text-muted">
      Exploring Node.js concepts step-by-step with practical examples.
    </p>
  </div>

  <div class="row g-4">
    <!-- Routing -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>📌 Routing</h3>
          <p>
            Learn how URLs are handled in Express.js and how routes connect
            users to pages.
          </p>
        </div>
      </div>
    </div>

    <!-- Middleware -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>⚙ Middleware</h3>
          <p>
            Understand request processing, logging, authentication, and custom
            middleware.
          </p>
        </div>
      </div>
    </div>

    <!-- EJS -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🎨 EJS Template Engine</h3>
          <p>
            Create dynamic web pages using EJS templates and reusable layouts.
          </p>
        </div>
      </div>
    </div>

    <!-- CRUD -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>📝 CRUD Operations</h3>
          <p>Create, Read, Update and Delete data using Express and MongoDB.</p>
        </div>
      </div>
    </div>

    <!-- MongoDB -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🍃 MongoDB</h3>
          <p>Learn NoSQL database concepts and data storage using MongoDB.</p>
        </div>
      </div>
    </div>

    <!-- Validation -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>✅ Validation</h3>
          <p>
            Validate form data using validator and express-validator before
            processing requests.
          </p>
        </div>
      </div>
    </div>


    <!-- 🌐 REST API -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🌐 REST API</h3>
          <p>
            Build RESTful APIs using Express.js and handle JSON data exchange.
          </p>
        </div>
      </div>
    </div>

    <!-- 🔄 Async Programming -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🔄 Async Programming</h3>
          <p>
            Understand Callbacks, Promises, Async/Await and asynchronous
            workflows.
          </p>
        </div>
      </div>
    </div>

    <!-- ⚠ Error Handling -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>⚠ Error Handling</h3>
          <p>
            Learn centralized error handling, try-catch, custom errors and
            middleware.
          </p>
        </div>
      </div>
    </div>

    <!-- ☁ Environment Variables  -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>☁ Environment Variables</h3>
          <p>Manage sensitive configuration using dotenv and process.env.</p>
        </div>
      </div>
    </div>

    <!-- 🚀 Deployment -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🚀 Deployment</h3>
          <p>
            Deploy Node.js applications to production servers and cloud
            platforms.
          </p>
        </div>
      </div>
    </div>

    <!-- Express Session -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🔐 Express Session</h3>
          <p>
            Learn Express Session authentication, login system, session storage,
            cookies, protected routes, logout, session timeout, and complete MVC implementation.
          </p>
        </div>
      </div>
    </div>

    <!-- Authentication -->
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3>🔐 Authentication</h3>
          <p>
            Implement Login, Registration, JWT Authentication, and Security.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

